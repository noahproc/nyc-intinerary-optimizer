# Leave blank to run fully offline on fixture data (the demo works without any keys).
GOOGLE_MAPS_API_KEY=
# "mock" forces fixtures even if a key is present; "google" uses Routes + Places API (New)
ROUTING_PROVIDER=mock
PLACES_PROVIDER=mock
# "live" pulls the public Citi Bike GBFS feed (no key needed); "mock" uses fixtures
BIKE_PROVIDER=live
